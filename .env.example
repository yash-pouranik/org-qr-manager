# ==============================================================================
# Organization QR Management Platform - Environment Configuration
# ==============================================================================

# Client Environment Variables (Exposed to browser via Vite - prefixed with VITE_)
# ------------------------------------------------------------------------------
# urBackend Publishable API Key (from https://app.urbackend.in)
VITE_URBACKEND_PUBLISHABLE_KEY=pk_live_sample_publishable_key_here

# Frontend Application Base URL (UI Domain: https://tools.gitaforlife.net in production)
VITE_APP_URL=http://localhost:5173

# Dynamic Redirect Base URL (Backend Domain: https://qr.gitaforlife.net in production, where /r/:shortCode routes)
VITE_REDIRECT_BASE_URL=https://qr.gitaforlife.net
REDIRECT_BASE_URL=https://qr.gitaforlife.net

# Server-Side Environment Variables (NEVER expose to client browser or git)
# ------------------------------------------------------------------------------
# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://tools.gitaforlife.net,https://qr.gitaforlife.net,https://gitaforlife.net

# Server port for dynamic HTTP 302 redirect engine and admin security runtime
PORT=3001

# urBackend Secret Key (Used exclusively by server for storage uploads & RLS bypass)
URBACKEND_SECRET_KEY=sk_live_sample_secret_key_here

# Initial Super Admin Bootstrapping Email
INITIAL_SUPER_ADMIN_EMAIL=admin@organization.local

# Direct MongoDB Connection String (For direct database indexing and high-speed operations)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/organization_qr?retryWrites=true&w=majority

# Daily Salt Secret for Privacy-Conscious Session Hashing (Rotated daily)
DAILY_SALT_SECRET=change_this_to_a_random_secure_secret_string
